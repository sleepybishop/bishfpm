use strict;
use warnings;
use Test::More;
use t::Util;
my ($err, $out, $status) = run_prog('./t/00util/bench_general 100 42');
is $status, 0, 'general benchmark and its count oracle complete';
is $err, '', 'benchmark has no diagnostics';
my @lines = split /\n/, $out;
is scalar(@lines), 3, 'CSV includes header and both stores';
my @ss = split /,/, $lines[1] // '';
my @fss = split /,/, $lines[2] // '';
is $ss[0], 'ss', 'default store measured';
is $fss[0], 'fss', 'experimental store measured';
is $ss[4], $fss[4], 'same pattern-store byte budget';
ok $ss[5] <= $ss[4] && $fss[5] <= $fss[4], 'both stores include sketch costs within budget';
is $ss[8], $fss[8], 'identical oracle-eligible opportunities';
ok $fss[16] <= $ss[16], 'FSS total peak payload does not exceed SS';
is $ss[11], 0, 'SS has no false confirmations';
is $fss[11], 0, 'FSS has no false confirmations';
done_testing();
